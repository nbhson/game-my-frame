VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Không có .env? Game vẫn chạy ở chế độ "Làng local":
# mở 2 tab cùng trình duyệt là thấy nhau đi lại + chat (BroadcastChannel),
# farm lưu ở localStorage như cũ.
